#!/usr/bin/env python3
"""Wire the swe always-on hook into Claude Code, Kiro and OpenCode, and the status line into Claude Code.

Kiro and OpenCode have no custom status line command, so they get only the hook.
Safe to re-run: an entry that is already present is left alone.
Use --dry-run to print what would change without writing.
Details: swe/references/always-on.md
"""
import argparse
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOOK = str(REPO / "swe" / "hooks" / "activate")
SKILL = str(REPO / "swe" / "SKILL.md")
STATUSLINE = str(REPO / "scripts" / "statusline")
HOME = Path(os.environ.get("HOME", "~")).expanduser()


def load(path):
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"{path}: not plain JSON ({e}). Add the entry by hand, see swe/references/always-on.md")


QUIET = False


def say(msg):
    if not QUIET:
        print(msg)


def save(path, data, dry):
    say(f"{'would write' if dry else 'wrote'} {path}")
    if dry:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def claude(dry):
    path = HOME / ".claude" / "settings.json"
    data = load(path)
    changed = False
    groups = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    if not any(h.get("command") == HOOK for g in groups for h in g.get("hooks", [])):
        groups.append({"hooks": [{"type": "command", "command": HOOK}]})
        changed = True
    # Only fill an empty slot: a statusLine you set yourself is never replaced.
    if "statusLine" not in data:
        data["statusLine"] = {"type": "command", "command": STATUSLINE, "padding": 0}
        changed = True
    if changed:
        save(path, data, dry)
    else:
        say(f"claude: already set in {path}")


def kiro(dry, agent):
    path = HOME / ".kiro" / "agents" / f"{agent}.json"
    data = load(path)
    data.setdefault("name", agent)
    spawn = data.setdefault("hooks", {}).setdefault("agentSpawn", [])
    if any(h.get("command") == HOOK for h in spawn):
        return say(f"kiro: already set in {path}")
    spawn.append({"command": HOOK})
    save(path, data, dry)


def opencode(dry):
    cfg = HOME / ".config" / "opencode"
    path = next((p for p in (cfg / "opencode.jsonc", cfg / "opencode.json") if p.exists()), cfg / "opencode.json")
    data = load(path)
    instructions = data.setdefault("instructions", [])
    if SKILL in instructions:
        return say(f"opencode: already set in {path}")
    instructions.append(SKILL)
    save(path, data, dry)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print changes, write nothing")
    ap.add_argument("--kiro-agent", default="default", help="Kiro agent config name (~/.kiro/agents/NAME.json)")
    ap.add_argument("--quiet", action="store_true", help="no output on success (for hooks)")
    args = ap.parse_args()
    global QUIET
    QUIET = args.quiet
    if not os.access(HOOK, os.X_OK):
        sys.exit(f"{HOOK} is missing or not executable")
    claude(args.dry_run)
    kiro(args.dry_run, args.kiro_agent)
    opencode(args.dry_run)
    say("Kiro IDE users: steering files are separate, see swe/references/always-on.md")


if __name__ == "__main__":
    main()
