#!/usr/bin/env python3
"""Run one factory pass headlessly in any supported harness, only if its deny policy is installed.

  tick <harness> [--dry-run]   check policy, then run one pass
  tick loop [harness] [seconds] [--once]
                               every few seconds, run a pass whenever `job queue` has a `run` row. Your board click
                               turns a `hold` into a `run`, so the next pass starts by itself. Stops retrying a
                               job that makes no progress (see STALL_LIMIT)
  tick check [harness]         exit 0 when the project's policy covers policy.yaml and every blocked command
  tick install [harness]       write the harness's policy into the project, replacing only files it stamped
  tick print [harness]         print the policy to merge by hand
  tick list                    print the blocked command prefixes, one per line

The harness is `harness` in .planning/factory/config.json. A harness argument that differs from it is refused.

The baseline rules (deny, ask, allow) live in ../policy.yaml. Every harness gets them, plus the stricter
denies below. Deny beats ask, and ask beats allow. An unattended pass cannot answer an ask, so an ask
stops the command until a human runs it.
"""
import fcntl, hashlib, json, os, re, shlex, shutil, signal, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("FACTORY_ROOT", Path.cwd())).resolve()
SKILL = "factory"
POLICY_DIR = Path(__file__).resolve().parent.parent
POLICY_FILE = POLICY_DIR / "policy.yaml"
POLICY_EXTRA = ["policy.build.yaml"]  # more rule files this skill loads
# ask beats broad allow rules such as `eslint *`.
REWRITE_ASK = []
PROMPT = ("Use the factory skill and run one pass (factory run). Wait for every stage agent you spawn. "
          "Plain git commit and git push are allowed; never force-push, merge, or create a PR or MR. Stop after the pass.")
GIT_WRITES = ["merge", "cherry-pick", "revert", "rebase", "am",
              "commit-tree", "update-ref", "symbolic-ref", "config", "fast-import"]
GIT_GLOBALS = ["-c", "-C", "--git-dir", "--work-tree", "--namespace"]
BLOCKED = ([("git", g) for g in GIT_WRITES] + [("git", g) for g in GIT_GLOBALS]
           + [("gh",), ("glab",), ("curl",), ("wget",), ("sh", "-c"), ("bash", "-c"), ("zsh", "-c")])
# Kiro denies by glob per command, so wrappers need their own entries.
KIRO_WRAPPERS = ["env", "xargs", "eval", "exec", "nohup", "sudo", "command", "builtin"]
# `git --no-pager commit` and every other global option hide the verb, so match the verb anywhere after `git`.
KIRO_GIT_ANYWHERE = [m for g in GIT_WRITES for m in (f"git * {g}", f"git * {g} *")]
KIRO_TOOLS = ["read", "write", "shell", "grep", "glob", "subagent"]
STAGE_TOOLS = [t for t in KIRO_TOOLS if t != "subagent"]  # only the orchestrator spawns agents
# config.json sets the harness, the allow list and the checks, so no agent may write it.
NO_WRITE = ["**/.kiro/**", "**/.claude/**", "**/.opencode/**", "**/opencode.json", "**/opencode.jsonc", "**/.git/**",
            "**/.planning/**/job.json", "**/.planning/**/audit.log", "**/.planning/**/config.json",
            "**/.planning/**/standing.md"]
WRITE_ONLY = None
WRITE_AREAS = {
    "planning": ["**/.planning/**"],
    "code": ["**/.worktrees/**", "**/.planning/factory/jobs/**"],
    "notes": ["**/.planning/factory/jobs/**"],
}
AREA_TEXT = {
    "planning": "files under .planning/",
    "code": "the job's worktree under .worktrees/ and the job folder under .planning/factory/jobs/",
    "notes": "your own notes in the job folder under .planning/factory/jobs/",
}
# Claude Code narrows a subagent by tool name only, never by folder, so a stage agent loses only the tools no stage
# needs. Folder limits stay with the project-wide settings and guard hook.
CLAUDE_TOOLS = ["Bash", "Read", "Write", "Edit", "Glob", "Grep", "NotebookEdit", "TodoWrite", "Skill"]
CLAUDE_DROPPED = ["Agent", "Task", "WebFetch", "WebSearch"]
OPENCODE_DROPPED = ["task", "webfetch", "websearch", "codesearch"]
# Each node file, built-in or from the catalog, names a model tier. A custom stage outside the catalog gets mid.
CLAUDE_TIER = {"large": "opus", "mid": "sonnet", "small": "haiku"}
GEN_VERSION = "factory-gen v1"
STAMP = re.compile(r"factory-gen v\d+ sha256:[0-9a-f]{64}")
HARNESS_SOURCE = "set harness in config.json"
KIRO_DESCRIPTION = "Software factory orchestrator. Runs one pass of the factory skill; plain git commit and push are allowed, never force-push or open a PR or MR."
KIRO_PROMPT = "Use the factory skill. Run one pass and stop. Plain git commit and push are allowed; never force-push, merge, or create a PR or MR."
COMMANDS = {
    "claude": lambda p: ["claude", "-p", p],
    "opencode": lambda p: ["opencode", "run", p],
    "kiro": lambda p: ["kiro-cli", "chat", "--v3", "--no-interactive", "--agent", "factory", p],
}
CONFIG = ROOT / ".planning" / SKILL / "config.json"


def die(msg, code=2):
    print(f"refused: {msg}", file=sys.stderr)
    sys.exit(code)


def strip_jsonc(text):
    return json.loads(re.sub(r'^\s*//.*$', "", text, flags=re.M))


def read_json(path, jsonc=False):
    try:
        text = Path(path).read_text()
        return strip_jsonc(text) if jsonc else json.loads(text)
    except (OSError, ValueError):
        return {}


def name(prefix):
    return " ".join(prefix)


def policy_rule_start(path, line):
    if line.split(":", 1)[1].strip() != "shell":
        die(f"{path.name}: only shell rules are supported, got {line!r}")
    return {"effect": None, "match": False}


def read_rule_line(path, out, rule, line, raw):
    if line.startswith("effect:"):
        rule["effect"] = line.split(":", 1)[1].strip()
        if rule["effect"] not in out:
            die(f"{path.name}: effect must be deny, ask, or allow, got {rule['effect']!r}")
    elif line == "match:":
        rule["match"] = True
    elif line.startswith("- ") and rule["match"] and rule["effect"]:
        out[rule["effect"]].append(line[2:].strip())
    else:
        die(f"{path.name}: cannot read line {raw!r}")


def load_policy(path=POLICY_FILE, strict=True):
    out = {"deny": [], "ask": [], "allow": []}
    rule = None
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line == "rules:":
            continue
        if line.startswith("- capability:"):
            rule = policy_rule_start(path, line)
        elif rule is None:
            die(f"{path.name}: unexpected line {raw!r}")
        else:
            read_rule_line(path, out, rule, line, raw)
    if strict and not all(out.values()):
        die(f"{path.name}: needs at least one deny, ask, and allow pattern")
    return out


def uniq(items):
    return list(dict.fromkeys(items))


def shell_policy(harness):
    base = load_policy()
    for extra in POLICY_EXTRA:
        more = load_policy(POLICY_DIR / extra, strict=False)
        base = {k: base[k] + more[k] for k in base}
    base["ask"] = base["ask"] + REWRITE_ASK
    stricter = [f"{name(b)} *" for b in BLOCKED]
    if harness == "kiro":
        stricter += [f"{w} *" for w in KIRO_WRAPPERS]
        stricter += KIRO_GIT_ANYWHERE
    deny, ask = uniq(base["deny"] + stricter), uniq(base["ask"])
    allow = [a for a in base["allow"] + [f"*/{SKILL}/bin/job *"] + project_allow() if a not in deny + ask]
    return {"deny": deny, "ask": ask, "allow": uniq(allow)}


def project_allow():
    """Commands this project allowed on top of policy.yaml: `allow` patterns and the `checks` command.

    No agent may write this file (NO_WRITE). A deny or ask still wins over anything it allows.
    """
    path = CONFIG
    cfg = read_json(path) if path.exists() else {}
    extra = cfg.get("allow", [])
    if not (isinstance(extra, list) and all(isinstance(x, str) and x.strip() for x in extra)):
        die(f"{path}: `allow` must be a list of non-empty strings")
    checks = cfg.get("checks", "")
    if not isinstance(checks, str):
        die(f"{path}: `checks` must be a string")
    parts = [c.strip() for c in re.split(r"&&|;", checks) if c.strip()]  # harness checks each part
    return uniq([x.strip() for x in extra] + ([checks.strip()] if checks.strip() else []) + parts)


def claude_rules(kind):
    pol = shell_policy("claude")[kind]
    rules = [f"Bash({p})" for p in pol]
    if kind == "deny":
        for g in GIT_WRITES:
            rules += [f"Bash(git * {g} *)", f"Bash(git * {g})"]
        rules += [f"Edit({g})" for g in NO_WRITE]
    if kind == "allow":
        rules += [f"Edit({g})" for g in WRITE_ONLY] if WRITE_ONLY else ["Edit"]
    return uniq(rules)


def opencode_rules():
    pol = shell_policy("opencode")
    rules = [{"action": "shell", "resource": p, "effect": e} for e in ("allow", "ask", "deny") for p in pol[e]]
    rules += [{"action": "edit", "resource": g, "effect": "allow"} for g in (WRITE_ONLY or ["**"])]
    rules += [{"action": "edit", "resource": g, "effect": "deny"} for g in NO_WRITE]
    return rules


def covers(wanted, have):
    return [p for p in wanted if p not in have]


def dict_at(d, key):
    v = d.get(key)
    return v if isinstance(v, dict) else {}


def claude_gaps(pol):
    deny, ask = set(), set()
    for f in ("settings.json", "settings.local.json"):
        perms = read_json(ROOT / ".claude" / f).get("permissions", {})
        deny |= set(perms.get("deny", []))
        ask |= set(perms.get("ask", []))
    gaps = [p for p in pol["deny"] if f"Bash({p})" not in deny]
    gaps += [p for p in pol["ask"] if f"Bash({p})" not in deny | ask]
    gaps += [f"write {g}" for g in NO_WRITE if f"Edit({g})" not in deny]
    hooks_now = read_json(ROOT / ".claude" / "settings.json").get("hooks")
    return gaps + guard_gaps("claude", hooks_now) + stage_gaps("claude")


def opencode_gaps(pol):
    cfg = {}
    for f in ("opencode.jsonc", "opencode.json"):
        if (ROOT / f).exists():
            cfg = read_json(ROOT / f, jsonc=True)
            break
    rules = {(r.get("action"), r.get("resource"), r.get("effect")) for r in cfg.get("permissions", [])}
    legacy_cfg = dict_at(cfg, "permission")
    legacy = dict_at(legacy_cfg, "bash")
    legacy_edit = dict_at(legacy_cfg, "edit")

    def effect(p):
        return {e for e in ("deny", "ask") if ("shell", p, e) in rules or legacy.get(p) == e}
    gaps = [p for p in pol["deny"] if "deny" not in effect(p)]
    gaps += [p for p in pol["ask"] if not effect(p)]
    gaps += [f"write {g}" for g in NO_WRITE if ("edit", g, "deny") not in rules and legacy_edit.get(g) != "deny"]
    agents = dict_at(cfg, "agent")
    expected = opencode_stage_agents()
    gaps += [f"opencode.jsonc agent {n} is missing or differs from `tick print opencode`"
             for n, a in expected.items() if agents.get(n) != a]
    gaps += [f"opencode.jsonc agent {n} is a generated stage agent that no stage uses"
             for n, a in agents.items() if n not in expected and is_generated_agent(n, a)]
    return gaps + guard_gaps("opencode", None)


def kiro_gaps(pol):
    cfg = read_json(ROOT / ".kiro" / "agents" / f"{SKILL}.json")
    rules = cfg.get("permissions", {}).get("rules", [])

    def matched(capability, effect):
        return {m for r in rules if r.get("capability") == capability and r.get("effect") == effect for m in r.get("match", [])}
    deny, ask = matched("shell", "deny"), matched("shell", "ask")
    gaps = [p for p in pol["deny"] if p not in deny]
    gaps += [p for p in pol["ask"] if p not in deny | ask]
    gaps += [f"write {g}" for g in NO_WRITE if g not in matched("fs_write", "deny")]
    gaps += guard_gaps("kiro", cfg.get("hooks"))
    if cfg.get("allowedTools"):
        gaps.append("agent must not carry allowedTools, which widen the rules")
    return gaps + stage_gaps("kiro")


def stage_gaps(harness):
    """Every generated stage file must match `tick print` byte for byte, and no stamped one may be left over."""
    gaps = []
    for rel, text in stage_files(harness).items():
        try:
            current = (ROOT / rel).read_text()
        except OSError:
            current = None
        if current != text:
            gaps.append(f"{rel} is missing or differs from `tick print {harness}`")
    return gaps + [f"{rel} is a generated stage agent that no stage uses" for rel in stamped_orphans(harness)]


def policy_gaps(harness):
    pol = shell_policy(harness)
    check = {"claude": claude_gaps, "opencode": opencode_gaps, "kiro": kiro_gaps}.get(harness)
    if check:
        return check(pol)
    die(f"unknown harness {harness!r}, expected one of {', '.join(COMMANDS)}")


GUARD_DIR = {"kiro": ".kiro/hooks", "claude": ".claude/hooks", "opencode": ".opencode/guard"}
OPENCODE_PLUGIN = """// Generated by `tick install opencode`. Runs the factory guard before every tool call and fails closed.
import { spawnSync } from "node:child_process";

const GUARD = %(guard)s;
const RULES = %(rules)s;

export const FactoryGuard = async ({ directory }) => ({
  "tool.execute.before": async (input, output) => {
    const event = { tool_name: input.tool, tool_input: output.args ?? {}, cwd: directory };
    const run = spawnSync("python3", [GUARD, RULES], { input: JSON.stringify(event), encoding: "utf8" });
    if (run.status !== 0) throw new Error(run.stderr || "blocked by the factory policy: the guard did not run");
  },
});
"""


def guard_rules(write_only):
    return json.dumps({**shell_policy("kiro"), "no_write": NO_WRITE, "write_only": write_only or []}, indent=2) + "\n"


def guard_command(harness, rules_rel):
    py = str(ROOT / f"{GUARD_DIR[harness]}/{SKILL}-guard.py")
    return f"python3 {shlex.quote(py)} {shlex.quote(str(ROOT / rules_rel))}"


def guard_files(harness):
    """The tool-call hook that enforces the whole policy even where the harness's own modes skip an ask.

    Returns ({relative path: text}, hook config for the harness, or None when the harness loads files itself).
    The rules use the strictest (Kiro) shell list.
    """
    base = f"{GUARD_DIR[harness]}/{SKILL}-guard"
    py, js = str(ROOT / f"{base}.py"), str(ROOT / f"{base}.json")
    files = {f"{base}.py": (Path(__file__).resolve().parent / "guard").read_text(),
             f"{base}.json": guard_rules(WRITE_ONLY)}
    command = guard_command(harness, f"{base}.json")
    if harness == "kiro":
        return files, {"preToolUse": [{"matcher": "*", "command": command}]}
    if harness == "claude":
        matcher = "Bash|Write|Edit|MultiEdit|NotebookEdit"
        return files, {"PreToolUse": [{"matcher": matcher, "hooks": [{"type": "command", "command": command}]}]}
    plugin = OPENCODE_PLUGIN % {"guard": json.dumps(py), "rules": json.dumps(js)}
    return {**files, f".opencode/plugins/{SKILL}-guard.js": plugin}, None


def guard_gaps(harness, hooks_now):
    files, hooks = guard_files(harness)
    gaps = [] if hooks_now == hooks else [f"the {harness} config must carry exactly the {SKILL} guard hook"]
    for rel, text in files.items():
        try:
            current = (ROOT / rel).read_text()
        except OSError:
            current = None
        if current != text:
            gaps.append(f"{rel} is missing or differs from `tick print {harness}`")
    return gaps


def policy_files(harness):
    if harness == "claude":
        perms = {kind: claude_rules(kind) for kind in ("deny", "ask", "allow")}
        files, hooks = guard_files("claude")
        status_rel = f".claude/hooks/{SKILL}-status.py"
        status = {"type": "command", "command": f"python3 {shlex.quote(str(ROOT / status_rel))} --claude"}
        settings = {"permissions": perms, "hooks": hooks, "statusLine": status}
        files[status_rel] = (Path(__file__).resolve().parent / "status").read_text()
        return {".claude/settings.json": json.dumps(settings, indent=2) + "\n", **files, **claude_stage_files()}
    if harness == "opencode":
        cfg = {"permissions": opencode_rules(), "agent": opencode_stage_agents()}
        return {"opencode.jsonc": json.dumps(cfg, indent=2) + "\n", **guard_files("opencode")[0]}
    if harness == "kiro":
        files, hooks = guard_files("kiro")
        agent = {
            "name": SKILL,
            "description": KIRO_DESCRIPTION,
            "prompt": KIRO_PROMPT,
            "tools": KIRO_TOOLS,
            "resources": [f"skill://.kiro/skills/{SKILL}/SKILL.md"],
            "hooks": hooks,
            "permissions": kiro_permissions(WRITE_ONLY),
        }
        return {f".kiro/agents/{SKILL}.json": json.dumps(agent, indent=2) + "\n", **files, **kiro_stage_files()}
    die(f"unknown harness {harness!r}, expected one of {', '.join(COMMANDS)}")


def kiro_permissions(write_only):
    pol = shell_policy("kiro")
    return {"rules": [
        {"capability": "fs_read", "effect": "allow"},
        {"capability": "fs_write", "effect": "allow", **({"match": write_only} if write_only else {})},
        {"capability": "shell", "effect": "allow", "match": pol["allow"]},
        {"capability": "shell", "effect": "ask", "match": pol["ask"]},
        {"capability": "fs_write", "effect": "deny", "match": NO_WRITE},
        {"capability": "shell", "effect": "deny", "match": pol["deny"]},
    ]}


def job_module():
    """bin/job, loaded once, so the stage list and pipeline.json checks live in one place."""
    if "job" not in _JOB_MOD:
        from importlib.machinery import SourceFileLoader
        from importlib.util import module_from_spec, spec_from_loader
        loader = SourceFileLoader("factory_job", str(JOB))
        mod = module_from_spec(spec_from_loader(loader.name, loader))
        loader.exec_module(mod)
        _JOB_MOD["job"] = mod
    return _JOB_MOD["job"]


_JOB_MOD = {}


def pipeline_stages():
    """[(stage id, skill, brief)] for every stage either workflow runs, in order, without the gate."""
    job = job_module()
    try:
        state = job.read_state()
    except SystemExit:
        sys.exit(2)
    custom = {c["id"]: c for c in state["stages"]}
    out = {}
    for wf in job.BASE_ORDER:
        for sid in state["order"][wf]:
            if sid == "gate" or sid in out:
                continue
            c = custom.get(sid)
            out[sid] = (c.get("skill", ""), c["brief"]) if c else (node(sid)["skill"], "")
    names = [f"{SKILL}-{sid}" for sid in out]
    clash = [n for n in names if n == f"{SKILL}-guard" or names.count(n) > 1]
    if clash:
        die(f"stage id would clash with a generated file: {', '.join(sorted(set(clash)))}")
    return [(sid, skill, brief) for sid, (skill, brief) in out.items()]


def node(sid):
    job = job_module()
    return job.NODES.get(sid) or job.load_catalog().get(sid, {})


def area_of(sid):
    return node(sid).get("writes", "notes")


def claude_model(sid):
    return CLAUDE_TIER[node(sid).get("model", "mid")]


def stamp():
    """Hash of pipeline.json, the node files and the generator version. The project folder is left out on purpose."""
    try:
        data = job_module().PIPELINE_FILE.read_bytes()
    except OSError:
        data = b""
    data += json.dumps([job_module().NODES, job_module().load_catalog()], sort_keys=True).encode()
    digest = hashlib.sha256(GEN_VERSION.encode() + b"\0" + data).hexdigest()
    return f"{GEN_VERSION} sha256:{digest}"


def stage_prompt(sid, skill, brief, area, preloaded=True):
    """Kiro preloads the skill as a resource. Claude Code and OpenCode have no verified preload, so the prompt loads it."""
    parts = [f"You are the factory {sid} stage agent. The orchestrator's message gives the job id, the job folder, "
             "the worktree and branch, and this stage's brief. Do this stage only."]
    if brief:
        parts.append(f"Stage brief: {brief}")
    if not skill:
        parts.append("No skill is preloaded for this stage." if preloaded else "This stage has no skill of its own.")
    else:
        parts.append(f"Your preloaded skill is {skill}." if preloaded else f"Load the {skill} skill before you start.")
    if node(sid).get("on_demand"):
        parts.append(node(sid)["on_demand"])
    parts += [
        "Before you edit a file, load the stack skill for that kind of file (.ts -> typescript-strict-style, "
        ".py -> python, and so on).",
        f"You may write only {AREA_TEXT[area]}. Everything else is read-only.",
        "Plain git commit and git push are allowed; never force-push, merge, rebase, or open a PR or MR, and never use the network beyond a plain push.",
        "Write the stage's file with its status line first, then reply with one line.",
    ]
    return " ".join(parts)


def kiro_stage_files():
    """One narrowed agent per stage, plus one guard rules file per write area."""
    files = {f"{GUARD_DIR['kiro']}/{SKILL}-guard-{a}.json": guard_rules(g) for a, g in WRITE_AREAS.items()}
    mark = stamp()
    for sid, skill, brief in pipeline_stages():
        area = area_of(sid)
        agent = {
            "name": f"{SKILL}-{sid}",
            "description": f"Factory {sid} stage agent. {mark}",
            "prompt": stage_prompt(sid, skill, brief, area),
            "tools": STAGE_TOOLS,
            "resources": [f"skill://.kiro/skills/{skill}/SKILL.md"] if skill else [],
            "hooks": {"preToolUse": [{"matcher": "*", "command": guard_command(
                "kiro", f"{GUARD_DIR['kiro']}/{SKILL}-guard-{area}.json")}]},
            "permissions": kiro_permissions(WRITE_AREAS[area]),
        }
        files[f".kiro/agents/{SKILL}-{sid}.json"] = json.dumps(agent, indent=2) + "\n"
    return files


def claude_stage_files():
    """One `.claude/agents/factory-<stage>.md` per stage: name, description (with the stamp), tools, model, prompt.

    Only the fields the probe ran are used. Claude Code narrows by tool name, not by folder, and review, prove and
    ship still write their own notes, so every stage keeps the file tools and loses only CLAUDE_DROPPED.
    """
    mark, files = stamp(), {}
    for sid, skill, brief in pipeline_stages():
        head = [f"name: {SKILL}-{sid}", f"description: Factory {sid} stage agent. {mark}",
                f"tools: {', '.join(CLAUDE_TOOLS)}", f"model: {claude_model(sid)}"]
        body = stage_prompt(sid, skill, brief, area_of(sid), preloaded=False)
        files[f".claude/agents/{SKILL}-{sid}.md"] = "---\n" + "\n".join(head) + "\n---\n\n" + body + "\n"
    return files


def opencode_stage_agents():
    """`agent.factory-<stage>` entries for opencode.jsonc: a subagent with the orchestrator's shell rules unchanged
    and file edits denied outside its write area."""
    mark, agents = stamp(), {}
    shell = {r["resource"]: r["effect"] for r in opencode_rules() if r["action"] == "shell"}
    for sid, skill, brief in pipeline_stages():
        area = area_of(sid)
        edit = {"*": "deny", **{g: "allow" for g in WRITE_AREAS[area]}, **{g: "deny" for g in NO_WRITE}}
        agents[f"{SKILL}-{sid}"] = {
            "description": f"Factory {sid} stage agent. {mark}",
            "mode": "subagent",
            "prompt": stage_prompt(sid, skill, brief, area, preloaded=False),
            "tools": {t: False for t in OPENCODE_DROPPED},
            "permission": {"edit": edit, "bash": shell},
        }
    return agents


def stage_files(harness):
    return {"kiro": kiro_stage_files, "claude": claude_stage_files}.get(harness, dict)()


def is_generated_agent(name, agent):
    desc = agent.get("description") if isinstance(agent, dict) else None
    return name.startswith(f"{SKILL}-") and isinstance(desc, str) and bool(STAMP.search(desc))


def is_stamped(path):
    """A file this tool generated and may replace. A Claude agent carries the stamp in its front matter; opencode.jsonc
    counts only when it holds nothing but the current orchestrator rules and stamped stage agents, no comments."""
    try:
        text = path.read_text()
    except OSError:
        return False
    if path.suffix == ".md":
        head = text.split("\n---\n", 1)[0] if text.startswith("---\n") else ""
        return any(line.startswith("description: ") and STAMP.search(line) for line in head.splitlines())
    if path.name == "opencode.jsonc":
        return opencode_is_ours(text)
    try:
        desc = json.loads(text).get("description", "")
    except (ValueError, AttributeError):
        return False
    return isinstance(desc, str) and bool(STAMP.search(desc))


def opencode_is_ours(text):
    try:
        cfg = json.loads(text)  # plain JSON only: a file with comments was edited by hand
    except ValueError:
        return False
    if not isinstance(cfg, dict) or set(cfg) - {"permissions", "agent"} or cfg.get("permissions") != opencode_rules():
        return False
    agents = cfg.get("agent", {})
    return isinstance(agents, dict) and all(is_generated_agent(n, a) for n, a in agents.items())


AGENT_GLOB = {"kiro": (".kiro/agents", "json"), "claude": (".claude/agents", "md")}


def stamped_orphans(harness, expected=None):
    """Stage agent files this tool made that no stage produces any more."""
    if harness not in AGENT_GLOB:
        return []
    expected = set(stage_files(harness) if expected is None else expected)
    rel_dir, ext = AGENT_GLOB[harness]
    folder = ROOT / rel_dir
    found = sorted(folder.glob(f"{SKILL}-*.{ext}")) if folder.is_dir() else []
    return [str(p.relative_to(ROOT)) for p in found if str(p.relative_to(ROOT)) not in expected and is_stamped(p)]


def log(harness, detail):
    state = ROOT / ".planning" / "factory"
    state.mkdir(parents=True, exist_ok=True)
    line = json.dumps({"ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "actor": "tick",
                       "action": "tick", "job": "", "detail": f"{harness}: {detail}"}) + "\n"
    fd = os.open(state / "audit.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line.encode())
    finally:
        os.close(fd)


def cmd_install(harness):
    """Write what is missing, replace only stamped stage files, delete stamped orphans, refuse any other clash."""
    files = policy_files(harness)

    def current(rel):
        try:
            return (ROOT / rel).read_text()
        except OSError:
            return None
    clashes = [f for f, text in files.items()
               if (ROOT / f).exists() and current(f) != text and not is_stamped(ROOT / f)]
    if clashes:
        die(f"already exists, merge the output of `tick print {harness}` by hand: " + ", ".join(clashes))
    for rel in stamped_orphans(harness, files):
        (ROOT / rel).unlink()
        print(f"removed {rel}")
    for rel, text in files.items():
        if current(rel) == text:
            continue
        dest = ROOT / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text)
        print(f"installed {rel}")


def cmd_print(harness):
    for rel, text in policy_files(harness).items():
        print(f"# {rel}\n{text}", end="")


def cmd_check(harness, quiet=False):
    gaps = policy_gaps(harness)
    if gaps:
        die(f"{harness} policy does not cover: {', '.join(gaps)}. Run `tick install {harness}` or merge the rules.")
    if not quiet:
        print(f"{harness}: policy ok")


def run_pass(harness):
    argv = COMMANDS[harness](PROMPT)
    if not shutil.which(argv[0]):
        die(f"{argv[0]} is not on PATH")
    limit = pass_timeout()
    log(harness, "start")
    # Its own process group, so a timeout also stops every agent the pass started.
    p = subprocess.Popen(argv, cwd=ROOT, start_new_session=True)
    try:
        code = p.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        stop_group(p)
        code = 124
    except KeyboardInterrupt:
        stop_group(p)
        raise
    log(harness, f"exit {code}")
    return code


def stop_group(p):
    for sig, grace in ((signal.SIGTERM, 5), (signal.SIGKILL, None)):
        try:
            os.killpg(p.pid, sig)
        except ProcessLookupError:
            break
        try:
            p.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            pass


def pass_timeout():
    """Seconds one agent pass may run before it is killed: `pass_timeout` in the project config, default 7200.
    An unreadable config falls back to the default; a value that is not a positive integer is refused."""
    path = ROOT / ".planning" / SKILL / "config.json"
    cfg = read_json(path) if path.exists() else {}
    value = cfg.get("pass_timeout", 7200) if isinstance(cfg, dict) else 7200
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        die(f"{path}: `pass_timeout` must be a positive number of seconds")
    return value


def cmd_run(harness, dry):
    cmd_check(harness, quiet=True)
    if dry:
        print(json.dumps(COMMANDS[harness](PROMPT)))
        return
    sys.exit(run_pass(harness))


STALL_LIMIT = 2  # passes in a row with no job-file change
JOB = POLICY_DIR / "bin" / "job"


def queue_rows():
    r = subprocess.run([sys.executable, "-I", str(JOB), "queue"], cwd=ROOT, capture_output=True, text=True,
                       env={**os.environ, "FACTORY_ROOT": str(ROOT), "FACTORY_NO_WATCH": "1"})
    if r.returncode:
        die(f"job queue failed: {r.stderr.strip()[-200:]}")
    return [line.split("\t") for line in r.stdout.splitlines() if line.strip()]


def jobs_fingerprint():
    h = hashlib.sha256()
    for p in sorted((ROOT / ".planning" / "factory" / "jobs").glob("*/job.json")):
        h.update(p.read_bytes())
    return h.hexdigest()


def loop_step(harness, stalls):
    """One look at the queue. Runs a pass when a job can run. Returns a one-line status."""
    todo = [r[1] for r in queue_rows() if r[0] == "run"]
    if not todo:
        return "idle: nothing to run"
    before = jobs_fingerprint()
    if stalls.get(before, 0) >= STALL_LIMIT:
        return f"stalled: {', '.join(todo)} made no progress in {STALL_LIMIT} passes, look at the board"
    code = run_pass(harness)
    if jobs_fingerprint() == before:
        stalls[before] = stalls.get(before, 0) + 1
    return f"pass for {', '.join(todo)} exit {code}"


def cmd_loop(harness, seconds, once):
    cmd_check(harness, quiet=True)
    state = ROOT / ".planning" / "factory"
    state.mkdir(parents=True, exist_ok=True)
    lock = open(state / "tick-loop.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another tick loop is already running for this project")
    stalls, last = {}, None
    try:
        while True:
            status = loop_step(harness, stalls)
            if status != last:
                print(f"{datetime.now().strftime('%H:%M:%S')} {status}", flush=True)
                last = status
            if once:
                return
            time.sleep(seconds)
    except KeyboardInterrupt:
        pass


def harness_for(given=None):
    """The project's harness, from `harness` in config.json. A different argument is refused. PATH is never read."""
    if given is not None and given not in COMMANDS:
        die(f"unknown harness {given!r}, expected one of {', '.join(COMMANDS)}")
    cfg = read_json(CONFIG) if CONFIG.exists() else {}
    chosen = cfg.get("harness") if isinstance(cfg, dict) else None
    if chosen is None:
        die(f"{HARNESS_SOURCE} ({CONFIG}): one of {', '.join(COMMANDS)}")
    if chosen not in COMMANDS:
        die(f"harness in config.json is {chosen!r}, expected one of {', '.join(COMMANDS)}")
    if given is not None and given != chosen:
        die(f"config.json says harness {chosen!r}, not {given!r}")
    return chosen


USAGE = "usage: tick <harness> [--dry-run] | check|install|print [harness] | loop [harness] [seconds] [--once] | list"

if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) in (1, 2) and a[0] in ("install", "check", "print"):
        h = harness_for(a[1] if len(a) == 2 else None)
        {"install": cmd_install, "check": cmd_check, "print": cmd_print}[a[0]](h)
    elif a and a[0] == "loop":
        rest = a[1:]
        given = rest.pop(0) if rest and not rest[0].isdigit() and rest[0] != "--once" else None
        nums = [x for x in rest if x != "--once"]
        if len(nums) > 1 or rest.count("--once") > 1 or not all(n.isdigit() and int(n) > 0 for n in nums):
            die("usage: tick loop [harness] [seconds] [--once]")
        cmd_loop(harness_for(given), int(nums[0]) if nums else 15, "--once" in rest)
    elif a == ["list"]:
        print("\n".join(name(b) for b in BLOCKED))
    elif len(a) in (1, 2) and a[0] in COMMANDS and (len(a) == 1 or a[1] == "--dry-run"):
        cmd_run(harness_for(a[0]), len(a) == 2)
    else:
        die(USAGE)
