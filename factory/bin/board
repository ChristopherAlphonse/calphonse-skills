#!/usr/bin/env python3
"""The factory board. It loads the factory engine (bin/job) and shows its jobs as two boards on one page:
Build (jobs that write code) and Review (read-only code reviews). It runs the button actions and answers the chat bar.

  board watch [port|auto]   run the board in the foreground
  board ensure              print the link of the running board, starting one if needed
"""
import contextlib, fcntl, hashlib, io, hmac, importlib.machinery, importlib.util, json, os, re, secrets, select, shutil, socket, subprocess, sys, tempfile, time
from http.cookies import CookieError, SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

ROOT = Path(os.environ.get("FACTORY_ROOT", Path.cwd())).resolve()
os.environ["FACTORY_ROOT"] = str(ROOT)
HERE = Path(__file__).resolve().parent
SKILLS = HERE.parent.parent
DASH_DIR = HERE.parent / "dashboard"
DIST_DIR = DASH_DIR / "dist"
STATE = ROOT / ".planning" / "factory-board"
STATIC_CSS = {"dashboard.css": "text/css"}
SCRIPT_NAME = re.compile(r"[a-z0-9][a-z0-9-]*\.js")
ENGINE_FILE = HERE / "job"
# The Python this process loaded. It reads these once, so an edit afterwards means the running board is out of date.
OWN_FILES = (HERE / "board", ENGINE_FILE)


def own_fingerprint():
    return tuple((p.stat().st_mtime_ns, p.stat().st_size) for p in OWN_FILES)


STARTED_AS = own_fingerprint()


def board_is_stale():
    try:
        return own_fingerprint() != STARTED_AS
    except OSError:
        return True


STALE_META = b'<span id="meta">restart the board: its code changed since it started</span>'
# board id -> (label, which of the engine's jobs it shows)
BOARD_SPECS = {"build": ("Build", lambda job: not job.get("review")), "review": ("Review", lambda job: bool(job.get("review")))}
WATCH_FILE = "watch.json"
CHAT_LOG = STATE / "chat.jsonl"
CHAT_SHOWN = 200
CHAT_MAX_BYTES = 1_000_000
FIRST_PORT = 8766
PORT_TRIES = 11
MAX_BODY = 64 * 1024
ASK_TIMEOUT = 300
COOKIE = "factory-board"
CSP = ("default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; frame-src 'self'; "
       "base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
# Diagram frames run in an opaque origin, so they carry no session cookie. They may use inline styles, which Mermaid's SVG needs, and nothing else.
FRAME_CSP = ("default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; "
             "base-uri 'none'; form-action 'none'; sandbox allow-scripts")
MAX_LIBRARY = 20_000_000
# Tab icons: a rounded square with a board glyph. The amber dot means something waits on the user.
FAVICON_GLYPH = {
    "factory": ("#e8e8e8", '<path d="M5 18V9l5 3V9l5 3V6h4v12z"/>'),
    "build": ("#7aa7ff", '<path d="M12 5l7 4-7 4-7-4zM5 13l7 4 7-4"/>'),
    "review": ("#6fd7a8", '<circle cx="11" cy="11" r="4.5"/><path d="M14.5 14.5L19 19"/>'),
}


def favicon_svg(board, dot):
    color, glyph = FAVICON_GLYPH.get(board, FAVICON_GLYPH["factory"])
    stroke = f'fill="none" stroke="{color}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"'
    badge = '<circle cx="19" cy="5" r="4" fill="#f0c36b" stroke="#161616" stroke-width="1.2"/>' if dot else ""
    return (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#161616"/>'
            f'<g {stroke}>{glyph}</g>{badge}</svg>')
SESSION = ""
CHAT_KEY = ""
CODE = ""
KEYS = {}

ENGINES = {"claude": "claude", "opencode": "opencode", "kiro": "kiro-cli"}
EFFORTS = ("low", "medium", "high", "xhigh", "max")
MODEL_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,99}")
CLAUDE_MODELS = ["opus", "sonnet", "haiku", "claude-fable-5-2", "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"]


def load_engine():
    """Import bin/job as a module. It is a script with a main guard, so importing runs nothing."""
    loader = importlib.machinery.SourceFileLoader("factory_engine", str(ENGINE_FILE))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ENGINE = None
CHAT_TURN_LIMIT = 20  # a resumed chat slows as it grows, so start a fresh one after this many turns
CHAT_TURNS = {}  # session id -> turns in that conversation; a resumed claude turn may come back under a new id
NEW_CHAT = "Started a new chat to keep it fast. Earlier messages are not carried over."


def engines():
    return [name for name, exe in ENGINES.items() if shutil.which(exe)]


def model_choices():
    """Model names to suggest per installed CLI."""
    out = {name: [] for name in engines()}
    if "claude" in out:
        out["claude"] = CLAUDE_MODELS
    if "opencode" in out:
        try:
            r = subprocess.run([ENGINES["opencode"], "models"], capture_output=True, text=True, timeout=8)
            out["opencode"] = r.stdout.split()[:200]
        except (OSError, subprocess.SubprocessError):
            pass
    if "kiro" in out:
        try:
            r = subprocess.run([ENGINES["kiro"], "chat", "--list-models"], capture_output=True, text=True, timeout=8)
            out["kiro"] = [l.split()[1 if l.startswith("*") else 0] for l in r.stdout.splitlines()[2:] if l.strip()]
        except (OSError, subprocess.SubprocessError, IndexError):
            pass
    return out


def ask_args(engine, exe, me, system, question, session, model, effort):
    """The command line for one chat turn. Only claude can limit the shell commands; the others run with the user's own tools."""
    if engine == "claude":
        args = [exe, "-p", "--output-format", "json", "--append-system-prompt", system,
                "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}', "--tools", "Read,Grep,Glob,Bash",
                "--allowedTools", f"Bash({me} skill:*)", f"Bash({me} brief:*)", f"Bash({me} note:*)", f"Bash({me} edit:*)",
                f"Bash({me} pipeline show)", f"Bash({me} pipeline propose:*)", f"Bash({me} pipeline clear)", "Read", "Grep", "Glob"]
        args += (["--model", model] if model else []) + (["--effort", effort] if effort else [])
        return args + (["--resume", session] if session else []), question[:4000]
    prompt = f"{system}\n\nUser: {question[:4000]}"
    if engine == "opencode":
        pick = f"{model}#{effort}" if model and effort and "#" not in model else model
        return [exe, "run", "--auto"] + (["--model", pick] if pick else []) + (["--session", session] if session else []) + [prompt], None
    return ([exe, "chat", "--v3", "--no-interactive", "--trust-tools=execute_bash,fs_read"] + (["--model", model] if model else [])
            + (["--effort", effort] if effort else []) + [prompt], None)


def ask(board, jid, question, session, engine, model, effort, act=False):
    """One chat turn through the chosen CLI for one board."""
    if board not in BOARD_SPECS:
        return {"error": f"no board {board!r}"}
    engine = engine if engine in ENGINES else "claude"
    exe = shutil.which(ENGINES[engine])
    if not exe:
        return {"error": f"{ENGINES[engine]} was not found on PATH"}
    if model and not MODEL_NAME.fullmatch(model):
        return {"error": f"bad model name {model!r}"}
    turns = CHAT_TURNS.get(session, 0) if session else 0
    fresh = turns >= CHAT_TURN_LIMIT
    if fresh:
        session, turns = "", 0
    note = lambda answer: f"{NEW_CHAT}\n\n{answer}" if fresh else answer
    args, stdin = ask_args(engine, exe, str(ENGINE.SELF), ENGINE.ask_system(jid, board, act), question, session, model, effort if effort in EFFORTS else "")
    try:
        r = subprocess.run(args, input=stdin, capture_output=True, text=True, timeout=ASK_TIMEOUT,
                           cwd=str(ROOT), env={**os.environ, "FACTORY_ROOT": str(ROOT), "FACTORY_CHAT_KEY": CHAT_KEY})
    except (OSError, subprocess.SubprocessError) as e:
        return {"error": f"chat failed: {e}"}
    if engine == "claude":
        try:
            out = json.loads(r.stdout)
        except ValueError:
            return {"error": (r.stderr or r.stdout).strip()[-500:] or "claude returned nothing"}
        if out.get("is_error"):
            return {"error": str(out.get("result", "claude reported an error"))[:500]}
        sid = out.get("session_id", "")
        count_turn(session, sid, turns)
        return {"answer": note(out.get("result", "")), "session": sid}
    ansi = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
    text = ansi.sub("", r.stdout).strip()
    if r.returncode or not text:
        return {"error": (ansi.sub("", r.stderr).strip() or text or f"{engine} exited {r.returncode}")[-500:]}
    count_turn(session, session, turns)
    return {"answer": note(text)}


def count_turn(old, new, turns):
    CHAT_TURNS.pop(old, None)
    if new:
        CHAT_TURNS[new] = turns + 1


FRAME_HEADERS = {"Content-Security-Policy": FRAME_CSP, "X-Frame-Options": "SAMEORIGIN"}
FRAME_FILES = {"mermaid.html": (DASH_DIR, "text/html; charset=utf-8"), "mermaid-frame.js": (DIST_DIR, "text/javascript")}


def mermaid_library():
    """The mermaid.min.js named by FACTORY_MERMAID, or None. Diagrams stay plain code until one is set."""
    path = os.environ.get("FACTORY_MERMAID", "")
    try:
        p = Path(path).expanduser().resolve() if path else None
        return p if p and p.suffix == ".js" and p.is_file() and p.stat().st_size <= MAX_LIBRARY else None
    except OSError:
        return None


def edit_file(old, new):
    return ENGINE.edit_allowed(old, new)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json", extra=None):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        headers = {"X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer"}
        if ctype.startswith("text/html"):
            headers["Content-Security-Policy"] = CSP
        for k, v in {**headers, **(extra or {})}.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def host_ok(self):
        return self.headers.get("Host", "") in (f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}")

    def session_ok(self):
        try:
            got = SimpleCookie(self.headers.get("Cookie", "")).get(f"{COOKIE}-{self.server.server_port}")
        except CookieError:
            return False
        return bool(got and SESSION) and hmac.compare_digest(got.value.encode(), SESSION.encode())

    def trusted(self):
        """Loopback Host, the session cookie, and a custom header a cross-site page cannot send."""
        return self.host_ok() and self.session_ok() and self.headers.get("X-Factory") == "1"

    def get_root(self, q):
        if not self.host_ok():
            return self.send(403, "{}")
        if self.session_ok():
            page = (DASH_DIR / "index.html").read_bytes()
            if board_is_stale():
                page = page.replace(b'<span id="meta">connecting</span>', STALE_META)
            return self.send(200, page, "text/html; charset=utf-8")
        supplied = q.get("c", [""])[0]
        if supplied and CODE and hmac.compare_digest(supplied.encode(), CODE.encode()):
            cookie = f"{COOKIE}-{self.server.server_port}={SESSION}; HttpOnly; SameSite=Strict; Path=/"
            return self.send(303, "", extra={"Location": "/", "Set-Cookie": cookie})
        return self.send(403, "{}")

    def get_frame(self, name):
        """Files for the sandboxed diagram frame. It has no cookie, so only the Host check guards them; none holds anything private."""
        if not self.host_ok():
            return self.send(403, "{}")
        if name == "mermaid.js":
            lib = mermaid_library()
            return self.send(200, lib.read_bytes(), "text/javascript", FRAME_HEADERS) if lib else self.send(404, "{}")
        if name not in FRAME_FILES:
            return self.send(404, "{}")
        base, ctype = FRAME_FILES[name]
        return self.send(200, (base / name).read_bytes(), ctype, FRAME_HEADERS)

    def get_static(self, name):
        """Any script in dist/ (the one folder the build writes to), plus the stylesheet. The name pattern has no slash or dot-dot."""
        if not (self.host_ok() and self.session_ok()):
            return self.send(403, "{}")
        if name in STATIC_CSS:
            return self.send(200, (DASH_DIR / name).read_bytes(), STATIC_CSS[name])
        script = DIST_DIR / name
        if not SCRIPT_NAME.fullmatch(name) or not script.is_file():
            return self.send(403, "{}")
        return self.send(200, script.read_bytes(), "text/javascript")

    def job_file(self, board, jid, name):
        """The markdown file `name` inside job `jid` on this board, or None. Never leaves the job folder."""
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", jid):
            return None
        try:
            if not any(j["id"] == jid and BOARD_SPECS[board][1](j) for j in ENGINE.all_jobs()):
                return None
            p = (ENGINE.jobdir(jid) / name).resolve()
            if ENGINE.jobdir(jid).resolve() not in p.parents or p.suffix != ".md" or not p.is_file():
                return None
            return p
        except (ValueError, OSError):
            return None

    def get_file(self, board, jid, name):
        p = self.job_file(board, jid, name)
        if not p:
            return self.send(404, "{}")
        try:
            data = p.read_bytes()
            return self.send(200, data, "text/plain; charset=utf-8", {"X-Base": hashlib.sha256(data).hexdigest()})
        except OSError:
            return self.send(404, "{}")

    def post_save(self, board, jid, body):
        """Replace a job file with edited text. `base` must still match the file on disk."""
        p = self.job_file(board, jid, body.get("name") if isinstance(body.get("name"), str) else "")
        text, base = body.get("text"), body.get("base")
        if not p:
            return self.send(404, "{}")
        if not isinstance(text, str) or not isinstance(base, str):
            return self.send(400, "{}")
        try:
            old = p.read_bytes()
            if not hmac.compare_digest(hashlib.sha256(old).hexdigest(), base):
                return self.send(409, json.dumps({"error": "changed"}))
            if not edit_file(old.decode(), text):
                return self.send(422, json.dumps({"error": "guarded"}))
            fd, tmp = tempfile.mkstemp(dir=p.parent, prefix=".edit-")
            with os.fdopen(fd, "w") as f:
                f.write(text)
            os.replace(tmp, p)
            return self.send(200, json.dumps({"base": hashlib.sha256(text.encode()).hexdigest()}))
        except (OSError, UnicodeDecodeError):
            return self.send(500, "{}")

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        if u.path == "/":
            return self.get_root(q)
        icon = re.fullmatch(r"/favicon-([a-z]+)\.svg", u.path)
        if icon:
            if not self.host_ok():
                return self.send(403, "{}")
            return self.send(200, favicon_svg(icon.group(1), q.get("dot", ["0"])[0] == "1"), "image/svg+xml")
        if u.path.startswith("/static/"):
            return self.get_static(u.path[len("/static/"):])
        if u.path.startswith("/frame/"):
            return self.get_frame(u.path[len("/frame/"):])
        if not self.trusted():
            return self.send(403, "{}")
        if u.path == "/api/boards":
            return self.send(200, json.dumps([{"id": b, "label": spec[0]} for b, spec in BOARD_SPECS.items()]))
        if u.path == "/api/chat":
            return self.send(200, json.dumps(chat_tail()))
        if u.path == "/api/features":
            return self.send(200, json.dumps({"mermaid": mermaid_library() is not None}))
        if u.path == "/api/engines":
            return self.send(200, json.dumps(model_choices()))
        m = re.fullmatch(r"/api/([a-z]+)/(jobs|file|stages)", u.path)
        if not m or m.group(1) not in BOARD_SPECS:
            return self.send(404, "{}")
        board = m.group(1)
        if m.group(2) == "stages":
            return self.send(200, json.dumps({
                "order": ENGINE.pipeline_order(board),
                "custom": {c["id"]: {"label": c["label"], "blurb": c["brief"] or c["label"]} for c in ENGINE.pipeline_custom() if c["workflow"] == board},
                "proposal": ENGINE.proposal_state()}))
        if m.group(2) == "jobs":
            return self.send(200, json.dumps([ENGINE.snapshot(j) for j in ENGINE.all_jobs() if BOARD_SPECS[board][1](j)]))
        return self.get_file(board, q.get("job", [""])[0], q.get("name", [""])[0])

    def do_POST(self):
        if not self.trusted():
            return self.send(403, "{}")
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self.send(400, "{}")
        if not 0 <= n <= MAX_BODY:
            return self.send(413, "{}")
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
            jid = body.get("id", "")
        except (ValueError, AttributeError):
            return self.send(400, "{}")
        if not isinstance(jid, str):
            return self.send(400, "{}")
        text = lambda k: body.get(k) if isinstance(body.get(k), str) else ""
        if self.path == "/api/ask":
            act = text("mode") == "act"
            out = ask(text("board"), jid, text("question"), text("session"), text("engine"), text("model"), text("effort"), act)
            if act and not out.get("error"):
                out["answer"] = (out.get("answer", "") + "\n\n" + apply_for_act()).strip()
            chat_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "board": text("board"), "job": jid, "question": text("question"), "mode": "act" if act else "chat",
                         "answer": out.get("answer", ""), "error": out.get("error", "")})
            return self.send(200, json.dumps(out))
        m = re.fullmatch(r"/api/([a-z]+)/save", self.path)
        if m and m.group(1) in BOARD_SPECS:
            return self.post_save(m.group(1), jid, body)
        m = re.fullmatch(r"/api/([a-z]+)/([a-z]+)", self.path)
        action = ENGINE.ACTIONS.get(m.group(2)) if m and m.group(1) in BOARD_SPECS else None
        if not action:
            return self.send(404, "{}")
        ENGINE.CTX.human = True
        try:
            action(jid, body)
        except SystemExit:
            return self.send(409, "{}")
        except Exception as e:
            if type(e).__name__ == "Refused":
                return self.send(409, "{}")
            print(f"board request {self.path} failed: {e!r}", file=sys.stderr)
            return self.send(500, "{}")
        finally:
            ENGINE.CTX.human = False
        self.send(200, "{}")


def rebuild_dashboard():
    """Regenerate dist/ when a .ts is newer. The committed dist is the fallback, so this never raises."""
    def warn(msg):
        print(f"dashboard: {msg}; serving the committed dist", file=sys.stderr)

    try:
        stale = any(not (DIST_DIR / f"{src.stem}.js").exists()
                    or src.stat().st_mtime > (DIST_DIR / f"{src.stem}.js").stat().st_mtime
                    for src in DASH_DIR.glob("*.ts"))
    except OSError as e:
        return warn(f"cannot compare sources with dist/ ({e})")
    if not stale:
        return
    node = shutil.which("node")
    if not node:
        return warn("a source is newer than dist/ but node is not on PATH")
    try:
        r = subprocess.run([node, str(DASH_DIR / "build.mjs")], cwd=DASH_DIR, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        return warn(f"rebuild failed ({e})")
    if r.returncode:
        warn(f"rebuild failed ({(r.stderr.strip().splitlines() or ['no output'])[-1]})")


def bind(port):
    if port != "auto":
        return ThreadingHTTPServer(("127.0.0.1", int(port)), Handler)
    for p in range(FIRST_PORT, FIRST_PORT + PORT_TRIES):
        try:
            return ThreadingHTTPServer(("127.0.0.1", p), Handler)
        except OSError:
            continue
    sys.exit(f"refused: no free port from {FIRST_PORT} to {FIRST_PORT + PORT_TRIES - 1}")


def apply_for_act():
    """In Act mode the user's choice of mode is the click: apply the change the agent just proposed, as the board, never as the agent."""
    if not ENGINE.proposal_state():
        return ""
    out, err = io.StringIO(), io.StringIO()
    ENGINE.CTX.human = True
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            ENGINE.cmd_pipeline("apply")
    except SystemExit:
        return "Not applied: " + (err.getvalue().strip().removeprefix("refused: ") or "the board refused it") + ". The change is still waiting under Pipeline change."
    finally:
        ENGINE.CTX.human = False
    return "Applied. The pipeline is now:\n" + "\n".join(f"- {l}" for l in out.getvalue().strip().splitlines())


def chat_append(entry):
    """Keep every chat turn on disk, so a reload or a restart does not lose it. Trimmed to the last CHAT_SHOWN turns past 1 MB."""
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        fd = os.open(CHAT_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(entry) + "\n")
        if CHAT_LOG.stat().st_size > CHAT_MAX_BYTES:
            write_private(CHAT_LOG, "".join(CHAT_LOG.read_text().splitlines(keepends=True)[-CHAT_SHOWN:]))
    except OSError as e:
        print(f"chat log not saved: {e!r}", file=sys.stderr)


def chat_tail():
    try:
        lines = CHAT_LOG.read_text().splitlines()[-CHAT_SHOWN:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def write_private(path, text):
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def cmd_watch(port):
    """Run the board. The engine gets the one key, whose hash its git hooks check."""
    global SESSION, CODE, ENGINE
    ENGINE = load_engine()
    rebuild_dashboard()
    SESSION, CODE = secrets.token_urlsafe(32), secrets.token_urlsafe(24)
    key = secrets.token_urlsafe(32)
    ENGINE.KEY = key
    ENGINE.STATE.mkdir(parents=True, exist_ok=True)
    write_private(ENGINE.STATE / ENGINE.HASH_FILE, hashlib.sha256(key.encode()).hexdigest() + "\n")
    global CHAT_KEY
    CHAT_KEY = secrets.token_urlsafe(32)
    write_private(ENGINE.STATE / ENGINE.CHAT_HASH_FILE, hashlib.sha256(CHAT_KEY.encode()).hexdigest() + "\n")
    srv = bind(port)
    ENGINE.audit("watch", "", f"port {srv.server_port}")
    print(f"watch: 127.0.0.1:{srv.server_port}/?c={CODE}", flush=True)
    srv.serve_forever()


def port_listening(port):
    with socket.socket() as sock:
        sock.settimeout(0.3)
        return sock.connect_ex(("127.0.0.1", int(port))) == 0


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def cmd_ensure():
    """Print the link of the running board for this project, starting one if needed. It outlives this command."""
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "watch.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            info = json.loads((STATE / WATCH_FILE).read_text())
        except (OSError, ValueError):
            info = {}
        if info.get("url") and pid_alive(info.get("pid")) and port_listening(info.get("port", 0)):
            print(info["url"])
            return
        child = subprocess.Popen(
            [sys.executable, "-I", str(Path(__file__).resolve()), "watch", "auto"], cwd=str(ROOT),
            env={**os.environ, "FACTORY_ROOT": str(ROOT)}, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, start_new_session=True, text=True)
        ready, _, _ = select.select([child.stdout], [], [], 10)
        line = child.stdout.readline() if ready else ""
        m = re.match(r"watch: (127\.0\.0\.1:(\d+)/\?c=\S+)", line)
        child.stdout.close()
        if not m:
            child.kill()
            child.wait()
            sys.exit("refused: the board could not start")
        write_private(STATE / WATCH_FILE, json.dumps({"pid": child.pid, "port": int(m.group(2)), "url": m.group(1)}))
        print(m.group(1))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "watch":
        cmd_watch(sys.argv[2] if len(sys.argv) > 2 else str(FIRST_PORT))
    elif cmd == "ensure":
        cmd_ensure()
    else:
        sys.exit("usage: board watch [port|auto] | board ensure")
